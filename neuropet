                <button type="submit" class="btn">Register for "Pure Best" Beta</button>
            </form>
        </div>
    </section>

    <footer>
        <div class="container">
            <p>&copy; 2025 NeuroPet Industries. "Pure Best" Hackathon Project.</p>
        </div>
    </footer>

</body>
</html>
