<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NeuroPet - Your "Pure Best" AI Companion</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap" rel="stylesheet">
    
    <style>
        /* --- "Pure Best" Global Reset & Dark Mode Base --- */
        :root {
            --bg-color: #050a14; /* "Pure Best" Darkest Navy Blue */
            --text-color: #d1d1f0; /* "Pure Best" Light Lavender */
            --primary-color: #00ffaa; /* "Pure Best" Neon Green/Cyan Accent */
            --nav-height: 60px;
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        html {
            scroll-behavior: smooth; /* "Pure Best" smooth scroll */
        }
        body {
            font-family: 'Orbitron', sans-serif; /* "Pure Best" Futuristic Font */
            background-color: var(--bg-color);
            color: var(--text-color);
            line-height: 1.6;
            padding-top: var(--nav-height); 
        }
        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* --- "Pure Best" Fixed Navbar --- */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: var(--nav-height);
            background-color: rgba(5, 10, 20, 0.8); /* "Pure Best" Transparent Navy */
            backdrop-filter: blur(5px);
            border-bottom: 1px solid var(--primary-color);
            z-index: 1000;
        }
        nav .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 100%;
        }
        .logo {
            font-size: 1.5rem;
            color: var(--primary-color);
            text-shadow: 0 0 5px var(--primary-color);
        }
        nav ul {
            list-style: none;
            display: flex;
        }
        nav ul li {
            margin-left: 25px;
        }
        nav ul li a {
            color: var(--text-color);
            text-decoration: none;
            transition: color 0.3s;
        }
        nav ul li a:hover {
            color: var(--primary-color); /* "Pure Best" Hover Effect */
        }

        /* --- "Pure Best" Section & Heading Styles --- */
        section {
            padding: 80px 0;
            min-height: 100vh; /* "Pure Best" Full-screen sections */
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        h2 {
            font-size: 2.5rem;
            text-align: center;
            margin-bottom: 40px;
            color: var(--primary-color);
            text-shadow: 0 0 10px var(--primary-color);
        }

        /* --- "Pure Best" Utility Button --- */
        .btn {
            display: inline-block;
            background-color: var(--primary-color);
            color: var(--bg-color);
            padding: 12px 25px;
            text-decoration: none;
            font-weight: 700;
            border: none;
            cursor: pointer;
            transition: transform 0.3s, box-shadow 0.3s;
        }
        .btn:hover {
            transform: scale(1.05); /* "Pure Best" Hover Effect */
            box-shadow: 0 0 15px var(--primary-color);
        }

        /* --- 1. "Pure Best" Home Section --- */
        #home {
            text-align: center;
            /* "Pure Best" Animated Gradient (No image needed!) */
            background: linear-gradient(45deg, #050a14, #000033);
            background-size: 400% 400%;
            animation: gradientBG 10s ease infinite;
        }
        @keyframes gradientBG {
            0% {background-position: 0% 50%;}
            50% {background-position: 100% 50%;}
            100% {background-position: 0% 50%;}
        }
        #home h2 {
            font-size: 3.5rem;
            margin-bottom: 20px;
        }
        #home p {
            font-size: 1.2rem;
            margin-bottom: 30px;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        /* --- 2. "Pure Best" Features Section (AI-Generated Text) --- */
        #features {
            background-color: #0a1122; /* "Pure Best" Slightly lighter */
        }
        .feature-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr); /* "Pure Best" 3 Columns */
            gap: 30px;
        }
        .feature-card {
            background-color: var(--bg-color);
            padding: 30px;
            border: 1px solid var(--primary-color);
            border-radius: 5px;
            transition: transform 0.3s, box-shadow 0.3s; /* "Pure Best" Hover Effect */
        }
        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 255, 170, 0.2);
        }
        .feature-card h3 {
            color: var(--primary-color);
            margin-bottom: 15px;
        }

        /* --- 3. "Pure Best" Contact Section (Visual Only) --- */
        #contact {
            text-align: center;
        }
        #contact p {
            margin-bottom: 30px;
        }
        #contact form {
            max-width: 500px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        #contact input,
        #contact textarea {
            padding: 15px;
            border: 1px solid var(--primary-color);
            background-color: transparent;
            color: var(--text-color);
            font-family: inherit;
            font-size: 1rem;
        }
        #contact input:focus,
        #contact textarea:focus {
            outline: none;
            box-shadow: 0 0 10px var(--primary-color);
        }

        /* --- "Pure Best" Footer --- */
        footer {
            padding: 20px 0;
            text-align: center;
            font-size: 0.9rem;
            color: #6a6a99;
            border-top: 1px solid var(--primary-color);
        }
    </style>
</head>
<body>

    <nav>
